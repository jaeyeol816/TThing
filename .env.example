# 대리 에이전트 메시 — 로컬 설정
# 실제 값이 든 .env 는 커밋되지 않는다 (.gitignore)
#   cp .env.example .env  후 토큰 기입

# ── 경로 · 바인딩 ────────────────────────────────────────────
MESH_DATA_ROOT=./data
MESH_BIND_HOST=127.0.0.1          # 0.0.0.0 금지. 재수화된 평문이 지나가는 표면이다
MESH_BIND_PORT=8080
MESH_DEV=0                        # 1 이면 /docs 활성

# ── 신뢰 구역 LLM (EXAONE) ───────────────────────────────────
# 이 값이 신뢰 경계의 위치를 정한다. 감사 로그에 매 질의 기록된다.
# 실배포 전환 = 이 값만 사내 서빙 엔드포인트로 바꾼다.
TRUSTED_ZONE_LLM_BASE_URL=https://api.friendli.ai/dedicated/v1
EXAONE_MODEL_ID=depe675tjc2rcpo
FRIENDLI_TOKEN=                   # ⚠️ .kiro/opencode.jsonc 에서 이전. 커밋 금지
EXAONE_MODE=live                  # live | mock
EXAONE_TIMEOUT_SECONDS=10

# ── Agent (경계 밖) ──────────────────────────────────────────
AGENT_TRANSPORT=direct            # broker | direct | mock
AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
DRAFT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1
BROKER_API_URL=                   # AGENT_TRANSPORT=broker 일 때만
BROKER_API_KEY=                   # ⚠️ 커밋 금지
AGENT_TIMEOUT_SECONDS=25

# ── 동작 파라미터 ────────────────────────────────────────────
SESSION_STALE_MINUTES=15
MAX_TARGETS=2
TOTAL_TIMEOUT_SECONDS=30
MAX_PAYLOAD_BYTES=2048
NGRAM_SIZE=5
NGRAM_SIZE_INTERNAL=3
CONFIDENCE_AUTO=0.75
CONFIDENCE_ESCALATE=0.45
STALE_CONFIDENCE_FACTOR=0.8

# ── 데모 보조 ────────────────────────────────────────────────
MESH_DEMO_NOW=                    # 예: 2026-08-19T14:35:00+09:00 (세션 신선도 고정)
MESH_RECORD_FIXTURES=0            # 1 이면 live 응답을 data/fixtures/ 에 녹화
