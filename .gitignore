# 해커톤 종료 후 Friendli 키를 폐기·재발급할 것. (SECURITY-12)
# ─────────────────────────────────────────────────────────────
.kiro/.env
.kiro/opencode.jsonc
.env
*.pem
*.key
*credentials*

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/

# 런타임 데이터 (재생성 가능)
data/mesh.db
data/mesh.db-shm
data/mesh.db-wal
data/verified/*.json
!data/verified/.gitkeep
data/sessions/local-*.json

# 사용자가 올린 문서. **사용자 데이터이며 소스가 아니다.**
# 커밋하면 남의 기밀 문서가 저장소 역사에 영구히 남는다 — 되돌릴 수 없다.
data/corpus/*/uploads/

# agents/ 새 구조 런타임 데이터
agents/shared/mesh.db
agents/shared/mesh.db-shm
agents/shared/mesh.db-wal
agents/*/gatekeeper/verified.json
agents/*/data/uploads/
agents/*/data/kb/

# CDK
